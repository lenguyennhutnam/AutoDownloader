{
    "InputPath": "./inputLinks.txt",
    "OutputDirPath": "./downloads",
    "Retries": 3,
    "RetryDelaySeconds": 2,
    "Mega": {
        "TimeoutSeconds": 600,
        "ServerStartupWaitSeconds": 3
    },
    "Telegram": {
        "Channel": "crabfast",
        "OutputDirPath": "./telefetch_data",
        "SplitSizeGB": 1,
        "Compression": "stored",
        "KeepOriginal": false,
        "SessionPath": "./telefetch_data/session"
    }
}
